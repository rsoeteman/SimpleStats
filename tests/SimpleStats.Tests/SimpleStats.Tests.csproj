<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimpleStats.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SimpleStats library compiles against the lowest supported Umbraco (18.0.0). These direct,
         floating references override that transitive version so the tests always run against the
         latest stable Umbraco 18.x release available at restore time. -->
    <PackageReference Include="Umbraco.Cms.Core" Version="18.*" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="18.*" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="18.*" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore" Version="18.*" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="18.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimpleStats\SimpleStats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\SimpleStats\appsettings-schema.simplestats.json"
          Link="appsettings-schema.simplestats.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
