<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimpleStats.Client</RootNamespace>
    <AssemblyName>SimpleStats.Client</AssemblyName>
    <Version>0.0.7-developermode</Version>
    <Description>Umbraco backoffice extension for SimpleStats.</Description>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>Umbraco.Community.SimpleStats.Client</PackageId>

    <!--
      Configure the static web asset base path so assets are served from
      /App_Plugins/SimpleStats/ when this library is referenced by an Umbraco site.
    -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco CMS – version range covers every Umbraco 18.x release, see SimpleStats.csproj for why -->
    <PackageReference Include="Umbraco.Cms.Core" Version="[18.0.0,19.0.0)" />
  </ItemGroup>

  <!--
    Include the compiled frontend assets from the Vite build output.
    Run `npm run build` inside this project directory first.
  -->
  <ItemGroup>
    <None Include="..\..\docs\nuget-readme.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\docs\images\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\App_Plugins\SimpleStats\umbraco-package.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\App_Plugins\SimpleStats\assets\" />
  </ItemGroup>

</Project>
