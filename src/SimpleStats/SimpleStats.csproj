<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimpleStats</RootNamespace>
    <AssemblyName>SimpleStats</AssemblyName>
    <Version>1.0.0</Version>
    <Description>An Umbraco package that provides site statistics in the backoffice.</Description>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>SimpleStats</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco CMS core – version range covers Umbraco 17, 18 and 19 -->
    <PackageReference Include="Umbraco.Cms.Core" Version="[17.0.0,20.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
