<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimpleStats</RootNamespace>
    <AssemblyName>SimpleStats</AssemblyName>
    <Version>0.0.7-developermode</Version>
    <Description>An Umbraco package that provides site statistics in the backoffice.</Description>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>Umbraco.Community.SimpleStats</PackageId>
    <PackageTags>umbraco;statistics;analytics;backoffice;umbraco-marketplace</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco CMS core – version range covers Umbraco 17.x only. Umbraco 18 replaced
         Swashbuckle.AspNetCore with Microsoft.AspNetCore.OpenApi (see
         https://github.com/umbraco/Announcements/issues/32), which is a binary and source
         breaking change for our OpenAPI/Swagger integration, so 18.x/19.x are not supported yet.
         Floor is 17.4.0, not 17.0.0: AddUmbracoDbContext's shareUmbracoConnection overload (used
         below) was not yet present in early 17.0.x patch releases. -->
    <PackageReference Include="Umbraco.Cms.Core" Version="[17.4.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="[17.4.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.4.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore" Version="[17.4.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.4.0,18.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Depend on the client package so App_Plugins assets flow into consuming Umbraco sites. -->
    <ProjectReference Include="..\SimpleStats.Client\SimpleStats.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget-readme.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\docs\images\icon.png" Pack="true" PackagePath="\" />
    <None Update="appsettings-schema.simplestats.json" Pack="true" PackagePath="\" />
    <None Update="msbuild\SimpleStats.props" Pack="true" PackagePath="buildTransitive\SimpleStats.props" />
  </ItemGroup>

</Project>
