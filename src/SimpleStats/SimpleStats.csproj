<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimpleStats</RootNamespace>
    <AssemblyName>SimpleStats</AssemblyName>
    <Version>0.0.7-developermode</Version>
    <Description>An Umbraco package that provides site statistics in the backoffice.</Description>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>Umbraco.Community.SimpleStats</PackageId>
    <PackageTags>umbraco;statistics;analytics;backoffice;umbraco-marketplace</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco CMS core – version range covers every Umbraco 18.x release. The floor is 18.0.0 so
         customers can pick any v18 version; NuGet resolves the lowest version in the range, so this
         library compiles against 18.0.0 and never uses APIs added in later 18.x patches. The ceiling
         excludes Umbraco 19, which has not been verified yet. Umbraco 17 is supported by SimpleStats 1.x. -->
    <PackageReference Include="Umbraco.Cms.Core" Version="[18.0.0,19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="[18.0.0,19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[18.0.0,19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore" Version="[18.0.0,19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[18.0.0,19.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Depend on the client package so App_Plugins assets flow into consuming Umbraco sites. -->
    <ProjectReference Include="..\SimpleStats.Client\SimpleStats.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget-readme.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\docs\images\icon.png" Pack="true" PackagePath="\" />
    <None Update="appsettings-schema.simplestats.json" Pack="true" PackagePath="\" />
    <None Update="msbuild\SimpleStats.props" Pack="true" PackagePath="buildTransitive\SimpleStats.props" />
  </ItemGroup>

</Project>
