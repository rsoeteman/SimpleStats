<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimpleStats</RootNamespace>
    <AssemblyName>SimpleStats</AssemblyName>
    <Version>0.0.7-developermode</Version>
    <Description>An Umbraco package that provides site statistics in the backoffice.</Description>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>SimpleStats</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco CMS core – version range covers Umbraco 17, 18 and 19. Floor is 17.4.0, not
         17.0.0: AddUmbracoDbContext's shareUmbracoConnection overload (used below) was not yet
         present in early 17.0.x patch releases. -->
    <PackageReference Include="Umbraco.Cms.Core" Version="[17.4.0,20.0.0)" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="[17.4.0,20.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.4.0,20.0.0)" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore" Version="[17.4.0,20.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Depend on the client package so App_Plugins assets flow into consuming Umbraco sites. -->
    <ProjectReference Include="..\SimpleStats.Client\SimpleStats.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
